<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="swarm_arena">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ambient fill light so robots are visible from all angles -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.3 0.3 0.4 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.5 -0.3 -0.7</direction>
    </light>

    <!-- ========== BLACK GROUND PLANE ========== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== BLUE GRID LINES (1m spacing) ========== -->
    <model name="grid_lines">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <!-- Horizontal lines (along X, spaced on Y) -->
        <visual name="h_n5"><pose>0 -5 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_n4"><pose>0 -4 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_n3"><pose>0 -3 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_n2"><pose>0 -2 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_n1"><pose>0 -1 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_0"><pose>0 0 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_p1"><pose>0 1 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_p2"><pose>0 2 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_p3"><pose>0 3 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_p4"><pose>0 4 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="h_p5"><pose>0 5 0 0 0 0</pose><geometry><box><size>10 0.015 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <!-- Vertical lines (along Y, spaced on X) -->
        <visual name="v_n5"><pose>-5 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_n4"><pose>-4 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_n3"><pose>-3 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_n2"><pose>-2 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_n1"><pose>-1 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_0"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_p1"><pose>1 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_p2"><pose>2 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_p3"><pose>3 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_p4"><pose>4 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
        <visual name="v_p5"><pose>5 0 0 0 0 0</pose><geometry><box><size>0.015 10 0.001</size></box></geometry>
          <material><ambient>0.0 0.3 1.0 1</ambient><diffuse>0.0 0.3 1.0 1</diffuse></material></visual>
      </link>
    </model>

    <!--
      Arena layout (10m x 10m):

        (-5,5) _____________________________ (5,5)
              |                               |
              |   A(-3,3)    B(-1,3)          |
              |   [DUMPER]   [DUMPER]          |
              |                               |
              | ============   ============== |
              |            [GAP]              |  <-- 1.0m gap at x=0
              | ============   ============== |
              |                               |
              |         C(0,-1)               |
              |         [DUMPER]              |
              |                 D(2,-3)       |
              |                 [DUMPER]       |
              |_______________________________|
        (-5,-5)                            (5,-5)
    -->

    <!-- ========== BOUNDARY WALLS ========== -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.1 0.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.1 0.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 10 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 10 0.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 10 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 10 0.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========== NARROW PASSAGE (1.0m gap at x=0) ========== -->

    <model name="passage_wall_left">
      <static>true</static>
      <pose>-2.75 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.5 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.5 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <model name="passage_wall_right">
      <static>true</static>
      <pose>2.75 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.5 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.5 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========== YIELD ZONE MARKERS ========== -->

    <model name="yield_zone_north">
      <static>true</static>
      <pose>0 0.8 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.8 0.6 0.002</size></box></geometry>
          <material><ambient>1.0 0.9 0.2 0.5</ambient><diffuse>1.0 0.9 0.2 0.5</diffuse></material></visual>
      </link>
    </model>

    <model name="yield_zone_south">
      <static>true</static>
      <pose>0 -0.8 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.8 0.6 0.002</size></box></geometry>
          <material><ambient>1.0 0.9 0.2 0.5</ambient><diffuse>1.0 0.9 0.2 0.5</diffuse></material></visual>
      </link>
    </model>

    <!-- ========== ROBOT A — Sender at (-3, 3) ========== -->
    <!--
      Mesh is visual only. Collision + wheels + diff_drive handle physics.
      Adjust <scale> below if the dumper appears too big or too small.
    -->
    <model name="robot_a">
      <static>false</static>
      <pose>-3 3 0 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.05 0 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.1</size></box></geometry></collision>
        <visual name="mesh">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/kayden/Downloads/code/hackathons/automation/robotic_dumper.glb</uri>
              <scale>0.15 0.15 0.15</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
      <link name="left_wheel">
        <pose>0 0.17 0.05 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
      <link name="right_wheel">
        <pose>0 -0.17 0.05 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
      <link name="caster">
        <pose>-0.1 0 0.025 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.025</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="left_wheel_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="caster_joint" type="ball"><parent>chassis</parent><child>caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.34</wheel_separation><wheel_radius>0.05</wheel_radius>
        <topic>/robot_a/cmd_vel</topic><odom_topic>/robot_a/odom</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </model>

